# ── JARVIS environment ─────────────────────────────────────────────
# Copy to .env and fill in values. NEVER commit .env.

# Runtime environment: dev | test | production
ENV=dev

# Database. Dev/test default is SQLite (zero-install).
# Production: postgresql+psycopg://user:pass@host:5432/jarvis  (Supabase)
DATABASE_URL=sqlite:///./data/jarvis.db

# Auth: dev = local single-user shim (Phase 1 only).
#       supabase = NOT IMPLEMENTED YET (fails fast until Phase 9).
AUTH_MODE=dev

# API
API_HOST=127.0.0.1
API_PORT=8000
WEB_ORIGIN=http://localhost:3000

# Frontend (Next.js) — read at build/dev time
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Session lifetime for the dev auth shim (hours)
SESSION_TTL_HOURS=720

# ── Supabase (planned Phase 9 — leave empty until then) ────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── AI providers (Phase 9) ──────────────────────────────────────
# Recommended hosted free-tier example: GROQ_API_KEY + LLM_PROVIDER=groq
# Valid names: stub, openai, anthropic, gemini, groq, local
# Empty = AI offline, by design
LLM_PROVIDER=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
LOCAL_LLM_BASE_URL=
LLM_BASE_URL=
LLM_MODEL=

# ── Integrations (all NOT_CONFIGURED until you add OAuth creds) ────
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
GITHUB_TOKEN=

# ── OpenAI Realtime voice (optional) ───────────────────────────────
# Disabled by default. Uses ephemeral server-minted client credentials.
OPENAI_REALTIME_ENABLED=false
OPENAI_REALTIME_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=alloy
OPENAI_REALTIME_EXPIRES_IN_SECONDS=60
