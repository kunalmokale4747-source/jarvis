# ── JARVIS environment ─────────────────────────────────────────────
# Copy to .env and fill in values. NEVER commit .env.

# Runtime environment: dev | test | production
ENV=dev

# Database. Dev/test default is SQLite (zero-install).
# Production: postgresql+psycopg://user:pass@host:5432/jarvis  (Supabase)
DATABASE_URL=sqlite:///./data/jarvis.db

# Auth: dev = local single-user shim (Phase 1 only).
#       supabase = NOT IMPLEMENTED YET (fails fast until Phase 9).
AUTH_MODE=dev

# API
API_HOST=127.0.0.1
API_PORT=8000
WEB_ORIGIN=http://localhost:3000

# Frontend (Next.js) — read at build/dev time
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Session lifetime for the dev auth shim (hours)
SESSION_TTL_HOURS=720

# ── Supabase (planned Phase 9 — leave empty until then) ────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── AI providers (planned Phase 2 — none configured) ───────────────
# openai | anthropic | gemini | local   (empty = AI offline, by design)
LLM_PROVIDER=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
LOCAL_LLM_BASE_URL=

# ── Integrations (all NOT_CONFIGURED until you add OAuth creds) ────
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
GITHUB_TOKEN=
